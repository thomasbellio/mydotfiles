AddKeysToAgent  yes
IdentityFile ~/.ssh/id_git_ed25519
IdentityFile ~/.ssh/lxc_id_ed25519
IdentityFile ~/.ssh/id_ansible_ed25519
IdentityFile ~/.ssh/id_localrouter_ed25519
IdentityFile ~/.ssh/id_ed25519_qualo


Host vmtunnel
    HostName 10.10.31.6
    User ams-dev
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # --- Backbone ---
    LocalForward 1433  localhost:1433     # MSSQL
    LocalForward 27017 localhost:27017    # MongoDB
    LocalForward 6379  localhost:6379     # Redis
    LocalForward 4369  localhost:4369     # RabbitMQ epmd
    LocalForward 5671  localhost:5671     # RabbitMQ AMQPS
    LocalForward 5672  localhost:5672     # RabbitMQ AMQP
    LocalForward 15672 localhost:15672    # RabbitMQ management UI

    # --- Identity ---
    LocalForward 35000 localhost:35000    # identity-service
    LocalForward 35001 localhost:35001    # identity-ui

    # --- Calendar ---
    LocalForward 35010 localhost:35010    # calendar-service

    # --- Cases Management ---
    LocalForward 35020 localhost:35020    # cases-management-application
    LocalForward 35021 10.10.31.6:35021    # cases-management-ui

    # --- Messaging ---
    LocalForward 35025 localhost:35025    # messaging-service

    # --- Dynamic Forms ---
    LocalForward 35030 localhost:35030    # dynamic-forms-service

    # --- Reporting ---
    LocalForward 35040 localhost:35040    # reporting-service

    # --- Data Import ---
    LocalForward 35050 localhost:35050    # data-import-service

    # --- Coaching ---
    LocalForward 35055 localhost:35055    # coaching-application
    LocalForward 35056 localhost:35056    # coaching-ui

